<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    
    <PropertyGroup>
        <Authors>Demortier Jeremy</Authors>
        <Description>C# DTOs for JDemetra WS</Description>
    </PropertyGroup>
    
    <ItemGroup>
        <Protobuf Include="../../../jdplus-ws/src/main/proto/jdplus/main/ws/v1/toolkit_messages.proto"
                  Link="proto/toolkit_messages.proto"
                  GrpcService="None" 
                  OutputDir="proto" 
                  CompileOutputs="false"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Google.Protobuf" />
      <PackageReference Include="Grpc.Net.Client" />
      <PackageReference Include="Grpc.Tools">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

</Project>
